  "Enable dashboard view rotation": "settingHaRotationEnabledTitle",
  "Cycle through the selected dashboard views in an endless loop, showing each one for the chosen number of seconds.": "settingHaRotationEnabledDescription",
  "Seconds per view": "settingHaRotationSecondsTitle",
  "How long each view stays on screen.": "settingHaRotationSecondsDescription",
  "Pause rotation on interaction (seconds)": "settingHaRotationPauseSecondsTitle",
