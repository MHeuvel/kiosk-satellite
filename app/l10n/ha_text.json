{
  "Log in automatically": "settingHaAutoLoginTitle",
  "Sign in to the dashboard with the access token above instead of showing the Home Assistant login page.": "settingHaAutoLoginDescription",
  "Keep connected in the background": "settingDisableSuspendTitle",
  "Turns off Home Assistant's \"Suspend background connections\" setting, which would otherwise drop the connection a few minutes after the screen goes off.": "settingDisableSuspendDescription",
  "Pause dashboard during screensaver": "settingFreezeOnScreensaverTitle",
  "Stops drawing the dashboard while the screensaver covers it, cutting CPU and GPU use; the connection stays live. Not for the Dim screensaver.": "settingFreezeOnScreensaverDescription",
  "Filter dashboard updates": "settingWsFilterTitle",
  "Only process updates for entities on the current view, cutting stutter on low-powered tablets. Views that cannot be resolved stay unfiltered.": "settingWsFilterDescription",
  "Pause HA dashboard camera streams during screensaver": "settingPauseDashboardCamerasTitle",
  "Pauses supported muted camera streams on the Home Assistant dashboard while the screensaver covers it. Streams reconnect when it closes. Does not affect the device camera or the Camera Streams feature.": "settingPauseDashboardCamerasDescription",
  "HA kiosk mode": "settingHaKioskModeTitle",
  "Hide the Home Assistant header and sidebar. Applies immediately.": "settingHaKioskModeDescription",
  "Hide the header": "settingHaKioskHideHeaderTitle",
  "Hide the dashboard toolbar and view tabs while HA kiosk mode is on. Leave off if you switch views from the header.": "settingHaKioskHideHeaderDescription",
  "Hide the sidebar": "settingHaKioskHideSidebarTitle",
  "Hide the navigation sidebar while HA kiosk mode is on.": "settingHaKioskHideSidebarDescription",
  "Show in the kiosk menu": "settingHaKioskMenuTitle",
  "Add an HA Kiosk Mode entry to the kiosk menu that turns it on and off.": "settingHaKioskMenuDescription",
  "Enable dashboard carousel": "settingHaDashboardCarouselTitle",
  "Swipe left or right on the dashboard to move between its views. Swipes on sliders, maps and scrolling cards are left alone.": "settingHaDashboardCarouselDescription",
  "Capture swipe gestures over cards": "settingHaCarouselOverCardsTitle",
  "Switch views even when the swipe starts on a card that reacts to swipes. Sliders still work normally.": "settingHaCarouselOverCardsDescription",
  "Enable haptics": "settingHaHapticsTitle",
  "Vibrate when buttons, switches, cards, sliders and thermostat dials are used. Requires a vibration motor.": "settingHaHapticsDescription",
  "Vibration strength": "settingHaHapticsStrengthTitle",
  "How strong the vibration feels.": "settingHaHapticsStrengthDescription",
  "Play tap sounds": "settingHaTapSoundTitle",
